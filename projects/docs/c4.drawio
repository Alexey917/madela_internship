        </mxCell>
        <mxCell id="C3rOKMNUUo-oruQVl63n-60" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="850" width="1610" x="400" y="-1169" as="geometry" />
        </mxCell>
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;C4Container\n  title C4 Container — Интернет-магазин (микросервисы, SAGA, Kafka/RabbitMQ)\n\n  Person(customer, \&quot;Покупатель\&quot;, \&quot;Выбирает товары, оформляет заказ, оплачивает, отслеживает статус SAGA\&quot;)\n  Person(admin, \&quot;Admin\&quot;, \&quot;Управляет каталогом: POST/PUT /products\&quot;)\n  System_Ext(pay_gateway, \&quot;Payment Gateway\&quot;, \&quot;Stripe / ЮKassa test + sandbox-заглушка&lt;br/&gt;Списание, refund, webhook\&quot;)\n\n  System_Boundary(shop, \&quot;Интернет-магазин\&quot;) {\n    Container(ui, \&quot;UI Service\&quot;, \&quot;React / Vue\&quot;, \&quot;Каталог, оформление заказа, оплата,&lt;br/&gt;статус SAGA, отображение компенсации\&quot;)\n    Container(gateway, \&quot;API Gateway\&quot;, \&quot;Nginx / Traefik / FastAPI + httpx\&quot;, \&quot;Единая точка входа&lt;br/&gt;Маршрутизация, JWT, Rate limiting, CORS\&quot;)\n\n    Container(catalog, \&quot;Catalog Service\&quot;, \&quot;FastAPI, SQLAlchemy, Alembic\&quot;, \&quot;Товары, категории&lt;br/&gt;GET /products, GET /products/{id}, POST/PUT&lt;br/&gt;Валидация Pydantic, пагинация, /health, /metrics\&quot;)\n    Container(order, \&quot;Order Service&lt;br/&gt;[SAGA Orchestrator]\&quot;, \&quot;FastAPI, Outbox, tenacity\&quot;, \&quot;Заказы: POST /orders, GET /orders/{id}, cancel&lt;br/&gt;SAGA: PENDING→RESERVED→PAID→COMPLETED&lt;br/&gt;FAILED→COMPENSATING→CANCELLED&lt;br/&gt;Idempotency-Key, таймаут оплаты 30s\&quot;)\n    Container(inventory, \&quot;Inventory Service\&quot;, \&quot;FastAPI, Outbox\&quot;, \&quot;Остатки: GET /stock/{id}, /reserve, /commit, /release&lt;br/&gt;idempotency_key в Redis 24h&lt;br/&gt;Подписка order.created\&quot;)\n    Container(payment, \&quot;Payment Service\&quot;, \&quot;FastAPI, httpx, tenacity\&quot;, \&quot;POST /payments, GET /payments/{id}, /refund&lt;br/&gt;Адаптер Gateway, retry 1s→2→4→8&lt;br/&gt;Идемпотентность по payment_id, webhook→брокер\&quot;)\n    Container(notification, \&quot;Notification Service\&quot;, \&quot;FastAPI consumer\&quot;, \&quot;Эмуляция email/SMS (лог + БД)&lt;br/&gt;Идемпотентная обработка, без дублей\&quot;)\n\n    ContainerDb(catalog_db, \&quot;Catalog DB\&quot;, \&quot;PostgreSQL\&quot;, \&quot;Товары, категории, Alembic миграции\&quot;)\n    ContainerDb(order_db, \&quot;Order + SAGA DB\&quot;, \&quot;PostgreSQL + Outbox\&quot;, \&quot;Заказы, состояние SAGA, таблица outbox, аудит Idempotency-Key\&quot;)\n    ContainerDb(inventory_db, \&quot;Inventory DB\&quot;, \&quot;PostgreSQL + Outbox\&quot;, \&quot;Остатки, резервы, outbox\&quot;)\n    ContainerDb(payment_db, \&quot;Payment DB\&quot;, \&quot;PostgreSQL\&quot;, \&quot;Транзакции, payment_id, статусы, refund\&quot;)\n    ContainerDb(notification_db, \&quot;Notification DB\&quot;, \&quot;PostgreSQL\&quot;, \&quot;Отправленные уведомления, обработанные event-id\&quot;)\n    ContainerDb(redis, \&quot;Redis\&quot;, \&quot;Redis\&quot;, \&quot;Кэш каталога TTL 60s&lt;br/&gt;Idempotency-Key TTL 24h\&quot;)\n\n    Container(broker, \&quot;Message Broker\&quot;, \&quot;Kafka / RabbitMQ\&quot;, \&quot;Топики: order.events, inventory.events,&lt;br/&gt;payment.events, notification.events&lt;br/&gt;Consumer groups / prefetch, DLQ, at-least-once\&quot;)\n    Container(monitoring, \&quot;Observability\&quot;, \&quot;Prometheus, Grafana, Sentry, Loki/ELK, structlog\&quot;, \&quot;/metrics, /health, RPS/latency/errors/очереди&lt;br/&gt;JSON-логи, Correlation ID, трейсинг ошибок\&quot;)\n  }\n\n  %% --- Внешние взаимодействия ---\n  Rel(customer, ui, \&quot;Использует\&quot;, \&quot;HTTPS\&quot;)\n  Rel(customer, gateway, \&quot;POST /orders + Idempotency-Key&lt;br/&gt;GET /products, /orders/{id}, /payments\&quot;, \&quot;HTTPS / JSON\&quot;)\n  Rel(admin, gateway, \&quot;POST/PUT /products\&quot;, \&quot;HTTPS + JWT\&quot;)\n  Rel(ui, gateway, \&quot;REST\&quot;, \&quot;HTTPS / JSON\&quot;)\n\n  %% --- Gateway -&gt; сервисы ---\n  Rel(gateway, catalog, \&quot;Маршрутизация\&quot;, \&quot;HTTP: GET /products\&quot;)\n  Rel(gateway, order, \&quot;Маршрутизация\&quot;, \&quot;HTTP: POST /orders\&quot;)\n  Rel(gateway, inventory, \&quot;Маршрутизация\&quot;, \&quot;HTTP: /stock/*\&quot;)\n  Rel(gateway, payment, \&quot;Маршрутизация\&quot;, \&quot;HTTP: /payments\&quot;)\n\n  %% --- Сервисы -&gt; хранилища ---\n  Rel(catalog, catalog_db, \&quot;Читает/пишет\&quot;, \&quot;SQLAlchemy / SQL\&quot;)\n  Rel(catalog, redis, \&quot;Кэш каталога\&quot;, \&quot;GET/SET TTL 60s\&quot;)\n  Rel(order, order_db, \&quot;Заказы + SAGA + outbox\&quot;, \&quot;SQL\&quot;)\n  Rel(order, redis, \&quot;Идемпотентность\&quot;, \&quot;Idempotency-Key TTL 24h\&quot;)\n  Rel(inventory, inventory_db, \&quot;Остатки, резервы\&quot;, \&quot;SQL\&quot;)\n  Rel(inventory, redis, \&quot;idempotency_key\&quot;, \&quot;SET NX TTL 24h\&quot;)\n  Rel(payment, payment_db, \&quot;Транзакции\&quot;, \&quot;SQL\&quot;)\n  Rel(notification, notification_db, \&quot;Лог отправок\&quot;, \&quot;SQL\&quot;)\n\n  %% --- Сервисы -&gt; брокер (публикации) ---\n  Rel(catalog, broker, \&quot;Публикует&lt;br/&gt;product.created, product.updated\&quot;, \&quot;Outbox worker → Kafka/RabbitMQ\&quot;)\n  Rel(order, broker, \&quot;Публикует команды&lt;br/&gt;inventory.reserve, payment.process, notification.send\&quot;, \&quot;Outbox, at-least-once\&quot;)\n  Rel(inventory, broker, \&quot;Публикует&lt;br/&gt;inventory.reserved, inventory.failed, inventory.released\&quot;, \&quot;Outbox + retry\&quot;)\n  Rel(payment, broker, \&quot;Публикует&lt;br/&gt;payment.succeeded, payment.failed, payment.refunded\&quot;, \&quot;retry tenacity\&quot;)\n\n  %% --- Брокер -&gt; сервисы (подписки) ---\n  Rel(broker, inventory, \&quot;order.created → резерв\&quot;, \&quot;consume order.events\&quot;)\n  Rel(broker, order, \&quot;inventory.reserved, payment.succeeded/failed\&quot;, \&quot;consume inventory.events, payment.events\&quot;)\n  Rel(broker, payment, \&quot;payment.process\&quot;, \&quot;consume order.events\&quot;)\n  Rel(broker, notification, \&quot;order.completed, order.cancelled,&lt;br/&gt;payment.succeeded/failed\&quot;, \&quot;consume *.events\&quot;)\n\n  %% --- Компенсации SAGA ---\n  Rel(order, broker, \&quot;Компенсация&lt;br/&gt;inventory.release, payment.refund\&quot;, \&quot;при FAILED\&quot;)\n\n  %% --- Платежный шлюз ---\n  Rel(payment, pay_gateway, \&quot;Списание / refund\&quot;, \&quot;httpx + tenacity&lt;br/&gt;exp. backoff 1→2→4→8, 3-5 попыток\&quot;)\n  Rel(pay_gateway, payment, \&quot;Webhook\&quot;, \&quot;HTTPS → payment.* в брокер\&quot;)\n\n  %% --- Наблюдаемость ---\n  Rel(catalog, monitoring, \&quot;Метрики/логи\&quot;, \&quot;/metrics, /health, structlog + Correlation ID\&quot;)\n  Rel(order, monitoring, \&quot;Метрики/логи SAGA-переходов\&quot;, \&quot;/metrics, /health\&quot;)\n  Rel(inventory, monitoring, \&quot;Метрики/логи\&quot;, \&quot;/metrics, /health\&quot;)\n  Rel(payment, monitoring, \&quot;Метрики/логи\&quot;, \&quot;/metrics, Sentry\&quot;)\n  Rel(notification, monitoring, \&quot;Метрики/логи\&quot;, \&quot;/metrics\&quot;)\n  Rel(gateway, monitoring, \&quot;RPS, latency, error rate\&quot;, \&quot;Prometheus\&quot;)\n  Rel(broker, monitoring, \&quot;Размер очередей, DLQ, lag\&quot;, \&quot;Prometheus/Grafana\&quot;)\n\n  UpdateLayoutConfig($c4ShapeInRow=\&quot;3\&quot;, $c4BoundaryInRow=\&quot;1\&quot;)\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="C3rOKMNUUo-oruQVl63n-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
