  <diagram name="Страница-1" id="AQYldHxdN1CF9aUgBr9N">
    <mxGraphModel dx="3647" dy="3072" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
