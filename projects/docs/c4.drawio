        <UserObject label="&lt;div style=&quot;font-size: 14px; line-height: 1.07; white-space: nowrap;&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;Message Broker&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;margin-top:3px;line-height:1.07;white-space:nowrap;&quot;&gt;&lt;b&gt;[Container: Kafka / RabbitMQ]&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11.48px;margin-top:3px;line-height:1.07;white-space:nowrap;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;" mermaidId="n:broker" mermaidBaseStyle="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontFamily=Open Sans,sans-serif;" mermaidBaseValue="&lt;div style=&quot;font-size:14px;font-weight:bold;line-height:1.07;white-space:nowrap;&quot;&gt;Message Broker&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;margin-top:3px;line-height:1.07;white-space:nowrap;&quot;&gt;[Container: Kafka / RabbitMQ]&lt;/div&gt;&lt;div style=&quot;font-size:11.48px;margin-top:3px;line-height:1.07;white-space:nowrap;&quot;&gt;Топики: order.events,&lt;br&gt;inventory.events,&amp;lt;br/&amp;gt;payment.events,&lt;br&gt;notification.events&amp;lt;br/&amp;gt;Consumer groups / prefetch,&lt;br&gt;DLQ, at-least-once&lt;/div&gt;" id="C3rOKMNUUo-oruQVl63n-5">
